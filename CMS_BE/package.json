{
  "name": "etpb-cms-be",
  "version": "1.0.0",
  "description": "ETPB Legal CRM backend (Express + Sequelize + PostgreSQL)",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon",
    "start": "node src/server.js",
    "db:migrate": "node src/database/migrate.js",
    "db:seed": "node src/database/seed.js",
    "db:setup": "node src/database/migrate.js && node src/database/seed.js",
    "db:reset": "node src/database/reset.js && node src/database/seed.js",
    "db:export-demo": "node scripts/export-demo-snapshot.js",
    "verify:env": "node scripts/verify-env.js",
    "test:auth": "node scripts/test-auth.js",
    "test:users": "node scripts/test-users.js",
    "test:courts": "node scripts/test-courts.js",
    "test:cases": "node scripts/test-cases.js",
    "test:reminders": "node scripts/test-reminders.js",
    "test:notifications": "node scripts/test-notifications.js",
    "test:settings": "node scripts/test-settings.js",
    "test:e2e": "node scripts/test-e2e.js",
    "test:smoke": "node scripts/test-auth.js && node scripts/test-users.js && node scripts/test-courts.js && node scripts/test-cases.js && node scripts/test-reminders.js && node scripts/test-notifications.js && node scripts/test-settings.js",
    "test:all": "npm run test:smoke && npm run test:e2e",
    "cleanup:smoke": "node scripts/cleanup-smoke.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.16.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
