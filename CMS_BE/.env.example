# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# PostgreSQL (local discrete vars)
# For Railway / hosted Postgres you may set DATABASE_URL instead of the POSTGRES_* vars.
# DATABASE_URL=postgresql://user:pass@host:5432/etpb_cms
# PGSSL=true
DB_ENGINE=postgres
POSTGRES_DB=etpb_cms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ipsdb
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# JWT — use a long random secret in any shared/staging/production environment
# Production requires JWT_SECRET length >= 24
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=8h

# CORS (frontend origin) — lock to your deployed FE origin in production
CORS_ORIGIN=http://localhost:3000

# Dev only: set DB_SYNC_ALTER=false to skip sequelize.sync({ alter: true }) after migrations
# DB_SYNC_ALTER=false

# Seed: existing demo cases are preserved by default. Set true to overwrite hearing dates / sample fields.
# SEED_OVERWRITE_CASES=true
